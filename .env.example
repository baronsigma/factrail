# Factrail environment

# INSEE Sirene API key — register at https://portail-api.insee.fr/
# Static key, no expiry, sent via X-INSEE-Api-Key-Integration header.
INSEE_API_KEY=

# --- Public HTTP endpoint (all optional; defaults shown) ---
# FACTRAIL_ALLOWED_HOSTS=mcp.factrail.online
# "*" allows browser-based MCP clients from any Origin (Host check stays on).
# Unset: requests carrying an Origin header are rejected (403).
# FACTRAIL_ALLOWED_ORIGINS=*
# Rate limits (client = CF-Connecting-IP / X-Forwarded-For when the peer is loopback)
# FACTRAIL_RATE_LIMIT_PER_MIN=60
# FACTRAIL_RATE_WINDOW_SECONDS=60
# FACTRAIL_RATE_BLOCK_AFTER=30
# FACTRAIL_RATE_BLOCK_SECONDS=300
# Known gateways (User-Agent substrings) get a separate, larger bucket
# FACTRAIL_GATEWAY_USER_AGENTS=SmitheryBot
# FACTRAIL_GATEWAY_RATE_LIMIT_PER_MIN=600
# FACTRAIL_GATEWAY_RATE_BLOCK_AFTER=0
# FACTRAIL_GATEWAY_CLIENT_HEADER=
# Hide deprecated legacy tools from tools/list (they stay callable)
# FACTRAIL_HIDE_LEGACY_TOOLS=0
